{
    "name": "app/web",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "arthurkushman/php-wss": ">=1.3",
        "aws/aws-sdk-php": "^3.82",
        "bluem/tree": "^3.1",
        "codeception/codeception": "^5.0",
        "codeception/module-phpbrowser": "^3.0",
        "cuyz/valinor": "^2.0",
        "doctrine/annotations": "^2.0",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^3.2 || ^4.0",
        "dragonmantank/cron-expression": "^3.0",
        "ezyang/htmlpurifier": "^4.9",
        "firebase/php-jwt": "^7.0",
        "geoip2/geoip2": "^3.0",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^2.0",
        "hashids/hashids": "^5.0",
        "irazasyed/telegram-bot-sdk": "^3.9",
        "j7mbo/twitter-api-php": "^1.0",
        "jms/serializer-bundle": "^5.5",
        "knplabs/knp-paginator-bundle": "^6.0",
        "laminas/laminas-code": "^4.8.0",
        "magyarandras/amp-converter": "^1.0",
        "matthiasmullie/minify": "^1.3",
        "mindbox/sdk": "^1.1",
        "monolog/monolog": "^3.0",
        "nelmio/cors-bundle": "^2.5",
        "neomerx/json-api": "^4.0",
        "neutron/sphinxsearch-api": "^2.0",
        "pda/pheanstalk": "^4.0",
        "php-http/guzzle7-adapter": "^1.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "psr/http-message": "^2.0",
        "ramsey/uuid": "^4.7",
        "react/child-process": "^0.6.4",
        "rybakit/msgpack": "^0.9",
        "scienta/doctrine-json-functions": "^6.2",
        "smalot/pdfparser": "^2.11",
        "sonata-project/admin-bundle": "^4.0",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "sonata-project/entity-audit-bundle": "^1.10",
        "sonata-project/intl-bundle": "^3.0",
        "spatie/enum": "^3.9",
        "spatie/schema-org": "^3.4",
        "swaggest/json-schema": "^0.12.43",
        "symfony/amazon-mailer": "7.4.*",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/notifier": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/ux-turbo": "^3.4",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/yaml": "7.4.*",
        "tarantool/client": "^0.10.0",
        "tarantool/mapper": "^5.0",
        "tattali/mobile-detect-bundle": "^7.0",
        "twig/cache-extra": "^3.18",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "vlucas/phpdotenv": "^5.5.0",
        "wa72/htmlpagedom": "^3.0",
        "woohoolabs/yang": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "captainhook/captainhook-phar": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "captainhook/captainhook-phar": "^5.29",
        "codeception/module-asserts": "^3.0",
        "codeception/module-doctrine": "^3.1",
        "codeception/module-symfony": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.5",
        "rector/rector": "^2.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*",
        "symplify/easy-coding-standard": "^12.5"
    }
}
