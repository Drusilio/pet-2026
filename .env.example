# Copy to .env.local and override local secrets. This file is a template only.

APP_ENV=dev
APP_SECRET=change-this-local-secret
APP_DEBUG=1

HTTP_PORT=8080
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

DATABASE_URL="mysql://app:app@mysql:3306/app?serverVersion=8.4.0&charset=utf8mb4"
DEFAULT_URI=http://localhost:8080
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
